# Обов'язково у Railway: окремий Volume, змонтований у /data.
# Шлях Volume визначається автоматично. Необов'язкове ручне перевизначення:
# MARYLEE_DATA_DIR=/data
MARYLEE_ADMIN_PASSWORD=
PUBLIC_URL=
PORT=3000

# Google OAuth: можна використати змінні ДРУГОГО сервісу YouTubeStories.
# Старі SHEET_ID, PROMPT_FOLDER_ID і токени соцмереж цей код не читає.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
MARYLEE_DRIVE_PARENT_ID=1sIcjn1IYI4uuw6TsBwyiKUKN6eNQUpXJ

OPENAI_API_KEY=
MARYLEE_TEXT_MODEL=gpt-4.1-mini
MARYLEE_IMAGE_MODEL=gpt-image-1
TTS_ENGINE=openai
TTS_OPENAI_VOICE=coral
ELEVENLABS_API_KEY=
TTS_ELEVEN_VOICE_ID=
TTS_ELEVEN_MODEL=eleven_multilingual_v2

# Розрахункові резерви, НЕ рахунок провайдера. Також діють добові ліміти запитів.
MARYLEE_TEXT_RESERVE_USD=0.10
MARYLEE_IMAGE_RESERVE_USD=0.30
MARYLEE_VOICE_RESERVE_PER_1000=0.50
